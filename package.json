{
  "name": "technova-ecommerce-lab",
  "version": "1.1.0",
  "description": "E-commerce lab focado em testes de integração e regressão QA",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "backend": "cd backend && node index.js",
    "frontend": "npx serve frontend -p 3000",
    "dev": "docker-compose up --build",
    "test:api": "newman run tests/technova_api.json",
    "test:e2e": "cypress run",
    "test:open": "cypress open"
  },
  "keywords": [
    "qa",
    "testing",
    "cypress",
    "newman",
    "integration"
  ],
  "author": "André Gonçalves",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^8.4.1",
    "cypress": "^13.17.0",
    "esbuild": "^0.27.4",
    "newman": "^6.1.2",
    "pg": "^8.11.3"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.js"
  }
}
