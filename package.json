{
  "name": "technova-ecommerce-lab",
  "version": "1.1.0",
  "description": "Lab de E-commerce para estudos de QA e DevOps",
  "main": "index.js",
  "scripts": {
    "backend": "cd backend && node index.js",
    "frontend": "npx serve frontend -p 3000",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "node scripts/setup-env.js",
    "dev": "npm run docker:up && (npm run backend & npm run frontend)",
    "test:api": "newman run tests/technova_api.json",
    "test:e2e": "npx cypress run"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "dotenv": "^17.3.1",
    "newman": "^6.1.3",
    "pg": "^8.11.3"
  }
}