{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-1234567890ef",
		"name": "TechNova API - Integration Tests",
		"description": "Suíte de testes corrigida para aceitar a estrutura de objectos da V2.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check - Get All Products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response should contain a products list\", function () {",
							"    const jsonData = pm.response.json();",
							"    // Ajuste: A API V2 pode devolver um array ou um objecto com .results",
							"    const products = jsonData.results || jsonData;",
							"    pm.expect(Array.isArray(products)).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "Search Product - Success",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Should find RTX 4090\", function () {",
							"    const jsonData = pm.response.json();",
							"    const products = jsonData.results || jsonData;",
							"    const hasRTX = products.some(p => p.name.includes('RTX 4090'));",
							"    pm.expect(hasRTX).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/products/search?q=RTX",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"products",
						"search"
					],
					"query": [
						{
							"key": "q",
							"value": "RTX"
						}
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000"
		}
	]
}